{
  "name": "rn-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android:dev": "cross-env ENVFILE=.env.dev react-native run-android --active-arch-only",
    "android:staging": "cd ./android && cross-env ENVFILE=.env.staging ./gradlew app:assembleRelease",
    "android:prod": "cd ./android && cross-env ENVFILE=.env.prod ./gradlew app:bundleRelease",
    "ios": "react-native run-ios",
    "ios:build": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle  --assets-dest ios",
    "start": "watchman watch-del-all && react-native start --reset-cache",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "commit": "git-cz",
    "tsc": "tsc -p tsconfig.json",
    "pod": "cd ios && pod install --verbose && cd ..",
    "postinstall": "npx husky install && npx patch-package",
    "prettier": "npx prettier --write --cache --cache-strategy metadata \"**/*.{tsx,ts}\"",
    "clean": "react-native-clean-project",
    "svg-init": "npx iconfont-rn",
    "e2e:ios": "detox test --configuration ios.sim.debug",
    "e2e:android": "detox test --configuration android.emu.debug",
    "delete": "rimraf types && tsc"
  },
  "dependencies": {
    "@byron-react-native/refresh-control": "^1.2.5",
    "@gorhom/bottom-sheet": "^4",
    "@react-native-aria/checkbox": "^0.2.3",
    "@react-native-aria/radio": "^0.2.5",
    "@react-native-community/netinfo": "^9.3.7",
    "@react-navigation/bottom-tabs": "^6.5.1",
    "@react-navigation/devtools": "^6.0.15",
    "@react-navigation/elements": "^1.3.17",
    "@react-navigation/native": "^6.1.1",
    "@react-navigation/native-stack": "^6.9.6",
    "@react-stately/checkbox": "^3.4.1",
    "@react-stately/toggle": "^3.5.1",
    "@sdcx/keyboard-insets": "^0.1.0",
    "@shopify/flash-list": "^2.2.0",
    "@shopify/react-native-skia": "^2.2.2",
    "@shopify/restyle": "^2.3.0",
    "ahooks": "^3.7.2",
    "axios": "^1.3.2",
    "crypto-js": "^4.1.1",
    "dayjs": "^1.11.7",
    "echarts": "^5.4.1",
    "lodash-es": "^4.17.21",
    "rc-field-form": "^1.27.4",
    "react": "19.1.0",
    "react-native": "0.80.2",
    "react-native-bootsplash": "^6.3.10",
    "react-native-config": "^1.5.6",
    "react-native-exception-handler": "^2.10.10",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^3.3.0",
    "react-native-modal": "^13.0.1",
    "react-native-pager-view": "^6.8.1",
    "react-native-picker": "^4.3.7",
    "react-native-reanimated": "^4.0.1",
    "react-native-reanimated-carousel": "^4.0.2",
    "react-native-restart": "^0.0.27",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.13.1",
    "react-native-svg": "^15.12.1",
    "react-native-tab-view": "^4.1.2",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "^0.4.1",
    "rive-react-native": "9.4.0",
    "stable-hash": "^0.0.6",
    "zustand": "^4.3.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^17.3.0",
    "@commitlint/config-conventional": "^17.3.0",
    "@react-native-community/cli": "19.1.1",
    "@react-native-community/cli-platform-android": "19.1.1",
    "@react-native-community/cli-platform-ios": "19.1.1",
    "@react-native/babel-preset": "0.80.2",
    "@react-native/eslint-config": "0.80.2",
    "@react-native/metro-config": "0.80.2",
    "@react-native/typescript-config": "0.80.2",
    "@testing-library/jest-native": "^5.4.2",
    "@testing-library/react-native": "^12.2.0",
    "@types/crypto-js": "^4.1.1",
    "@types/jest": "^29.5.13",
    "@types/lodash-es": "^4.17.6",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.37.0",
    "@typescript-eslint/parser": "^5.37.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-import": "^1.13.6",
    "babel-plugin-module-resolver": "^4.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "commitizen": "^4.2.6",
    "cross-env": "^7.0.3",
    "cz-customizable": "^7.0.0",
    "detox": "^20.11.2",
    "eslint": "^8.19.0",
    "husky": "^8.0.2",
    "inquirer": "^9.2.2",
    "jest": "^29.6.3",
    "lint-staged": "^13.1.0",
    "react-native-clean-project": "^4.0.1",
    "react-native-iconfont-cli": "^2.2.4",
    "react-test-renderer": "18.2.0",
    "reactotron-react-native": "^5.1.9",
    "shelljs": "^0.8.5",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "testPathIgnorePatterns": [
      "/__tests__/",
      "/e2e/"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,md}": [
      "npm run prettier"
    ]
  },
  "resolutions": {
    "@react-aria/utils": "3.6.0"
  } 
}
