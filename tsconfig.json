// prettier-ignore
{
  "extends": "@react-native/typescript-config",     /* Recommended React Native TSConfig base */
  "compilerOptions": {
    "noEmit": true,
    "pretty": true,
    /* Visit https://aka.ms/tsconfig.json to read more about this file */
    "paths": {
      "@/*": ["./src/*"]
    },
    /* Completeness */
    "skipLibCheck": true                             /* Skip type checking all .d.ts files. */
  },
  "include": ["src/**/*", "types"],
  "exclude": ["node_modules", "src/components/Icon"]
}
